# Copy this file to `.env` (same folder as docker-compose.yml) and adjust the
# values before running `docker compose up`. `.env` is git-ignored on purpose
# because it holds secrets.

# SQL Server "sa" password. Must satisfy SQL Server's complexity rules:
# at least 8 characters, with upper+lower case, a digit and a symbol.
DB_SA_PASSWORD=Str0ng!Passw0rd#2026

# Secret key used to sign JWT access tokens (32+ characters recommended).
JWT_SECRET_KEY=Str0ng!Passw0rd#2026SuperSecretKeyForHS256Docker

# ASP.NET Core environment for the API container.
# "Development" keeps Swagger UI enabled at http://localhost:<API_PORT>/ and
# turns auth rate limiting OFF (see appsettings.Development.json).
# "Production" loads appsettings.Production.json and turns rate limiting ON.
ASPNETCORE_ENVIRONMENT=Development

# Auth rate-limit window (applied when the limiter is enabled, i.e. Production).
# Do not set RATE_LIMITING_ENABLED here unless you intend to override the
# environment's appsettings — Compose does not pass RateLimiting__Enabled so
# Production stays on and Development stays off.
RATE_LIMITING_PERMIT_LIMIT=10
RATE_LIMITING_WINDOW_SECONDS=60

# Host ports (change if any of these are already taken on your machine).
SQL_PORT=1433
API_PORT=8080
CLIENT_PORT=4200
